# ── Server ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (TimescaleDB compatible).
# Local default works with `docker compose up -d`.
# For Vercel: provision a Neon (https://neon.tech) or Supabase database
# and paste the connection string here.
DATABASE_URL="postgresql://conduit:conduit_dev@localhost:5432/conduit"

# Redis connection string.
# Local default works with `docker compose up -d`.
# For Vercel: provision an Upstash Redis (https://upstash.com) instance
# and paste the connection string here (use the ioredis-compatible URL).
REDIS_URL="redis://localhost:6379"

# Stellar RPC endpoint used to build/submit Soroban transactions.
# Local default points to the Stellar Quickstart container.
# For production use the official Horizon/Soroban RPC:
#   https://soroban-testnet.stellar.org  (testnet)
#   https://soroban.stellar.org          (mainnet)
STELLAR_RPC_URL="http://localhost:8000/soroban/rpc"

# Stellar network passphrase.
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Secret used to sign JWTs. Must be a long, random string in production.
JWT_SECRET="change-me-in-production"

# Port the Bun server listens on (local dev only; ignored on Vercel).
PORT="5000"

# Allowed CORS origin for the API server.
# For Vercel: set this to your Vercel frontend URL, e.g. https://your-app.vercel.app
CLIENT_URL="http://localhost:3000"

# ── Client (Vite) ───────────────────────────────────────────────────────────

# Base URL the React app uses to reach the API.
# In development the Vite dev-server proxy forwards /api → localhost:5000,
# so this variable is not needed locally.
# For Vercel: leave empty (rewrites in vercel.json forward /api to the
# serverless function) or set to your custom backend URL if self-hosting.
VITE_API_URL=""

# WebSocket URL the React app connects to for live yield updates.
# In development: ws://localhost:5000
# On Vercel: WebSockets are not supported in serverless functions.
# Deploy the Bun server separately (Railway / Render / Fly.io) and set
# this to that service's ws:// or wss:// URL.
VITE_WS_URL="ws://localhost:5000"

# ── Gemini AI ────────────────────────────────────────────────────────────────

# API key for Gemini AI (used by the COND agent chat endpoint).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Misc ─────────────────────────────────────────────────────────────────────

# The public URL of the deployed app (used for self-referential links).
APP_URL="MY_APP_URL"
