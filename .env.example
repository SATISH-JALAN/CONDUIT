# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Stellar / Soroban ──
# Network endpoints (defaults target Stellar testnet).
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Set SOROBAN_ENABLED=true AND STREAM_ROUTER_CONTRACT_ID to make deposits/harvests
# real on-chain contract invocations (deposit/harvest move actual SAC tokens).
# When either is unset, the server falls back to the legacy native-payment path.
SOROBAN_ENABLED="false"
STREAM_ROUTER_CONTRACT_ID=""
COMPLIANCE_CONTRACT_ID=""

# Address of the custodied yield asset (SAC) and its decimal precision.
YIELD_ASSET_DECIMALS="7"
# Inclusion fee (stroops) for Soroban txs; the resource fee is added automatically.
SOROBAN_INCLUSION_FEE="1000000"
